<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.fbtools.dbeaver</groupId>
        <artifactId>fbtools-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>dev.fbtools.dbeaver.psqldebug</artifactId>
    <packaging>eclipse-plugin</packaging>

    <dependencies>
        <!-- Só para os Testes diferenciais (ADR 0005), que rodam fora do OSGi. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- O mesmo jar de lib/ (Bundle-ClassPath). O Tycho já o põe no classpath; o JUnit do Eclipse só o vê por aqui. -->
        <dependency>
            <groupId>org.antlr</groupId>
            <artifactId>antlr4-runtime</artifactId>
            <version>${antlr.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.firebirdsql.jdbc</groupId>
            <artifactId>jaybird</artifactId>
            <version>${jaybird.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Fora de src/, que é a pasta de fontes do plugin (build.properties). -->
        <testSourceDirectory>test</testSourceDirectory>
        <plugins>
            <!-- Gera o parser em target/generated-sources/antlr4, que o build.properties inclui como fonte. -->
            <plugin>
                <groupId>org.antlr</groupId>
                <artifactId>antlr4-maven-plugin</artifactId>
                <version>${antlr.version}</version>
                <configuration>
                    <sourceDirectory>${project.basedir}/antlr4</sourceDirectory>
                    <visitor>true</visitor>
                    <listener>false</listener>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>antlr4</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- O ciclo eclipse-plugin do Tycho não liga nada à fase test; os testes são JUnit puro. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
                <executions>
                    <execution>
                        <id>unit-tests</id>
                        <phase>test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                    </execution>
                </executions>
                <!-- Sem systemPropertyVariables: o m2e copia essa configuração para o launch de JUnit do Eclipse,
                     que não resolve propriedades do Maven. O TestDatabase acha o fbdebug-test.properties sozinho. -->
            </plugin>
        </plugins>
    </build>
</project>
