<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

    <!-- ===== Launch e modelo de debug (issue 13) ===== -->

    <!-- Só dá nome à Sessão de debug na view Debug: o launch sai do comando "Depurar Rotina". -->
    <extension point="org.eclipse.debug.core.launchConfigurationTypes">
        <launchConfigurationType
                id="dev.fbtools.dbeaver.psqldebug.launchType"
                name="Firebird PSQL"
                delegate="dev.fbtools.dbeaver.psqldebug.debug.PsqlLaunchDelegate"
                modes="debug"
                public="false"/>
    </extension>

    <!-- Rótulos, detalhe dos valores e o editor da linha da pausa (issue 14). -->
    <extension point="org.eclipse.debug.ui.debugModelPresentations">
        <debugModelPresentation
                id="dev.fbtools.dbeaver.psqldebug.psql"
                class="dev.fbtools.dbeaver.psqldebug.editor.PsqlModelPresentation"/>
    </extension>

    <!-- Watches da view Expressions, avaliados no servidor com as variáveis do frame selecionado (issue 16). -->
    <extension point="org.eclipse.debug.core.watchExpressionDelegates">
        <watchExpressionDelegate
                debugModel="dev.fbtools.dbeaver.psqldebug.psql"
                delegateClass="dev.fbtools.dbeaver.psqldebug.debug.PsqlWatchExpressionDelegate"/>
    </extension>

    <extension point="org.eclipse.ui.commands">
        <command
                id="dev.fbtools.dbeaver.psqldebug.debugRoutine"
                name="Depurar Rotina"
                description="Inicia uma Sessão de debug da Rotina Firebird"/>
        <command
                id="dev.fbtools.dbeaver.psqldebug.rulerToggleBreakpoint"
                name="Alternar Breakpoint"
                description="Alterna o breakpoint da linha clicada no ruler do editor de Rotina Firebird"/>
        <command
                id="dev.fbtools.dbeaver.psqldebug.openPackage"
                name="Abrir Package..."
                description="Mostra o corpo de uma package Firebird num console, para depurar as rotinas dela"/>
    </extension>

    <!-- Ícones dos jars do debug.ui e do DBeaver, sem cópia no plugin, como o DBeaver faz nos comandos dele. O caminho
         do package.svg é interno ao DBeaver: se mudar num upgrade, o item só fica sem ícone (ADR 0004). O submenu
         "PSQL Debug" fica sem ícone, por estar na barra de menus. -->
    <extension point="org.eclipse.ui.commandImages">
        <image
                commandId="dev.fbtools.dbeaver.psqldebug.debugRoutine"
                icon="platform:/plugin/org.eclipse.debug.ui/icons/full/etool16/debug_exc.svg"/>
        <image
                commandId="dev.fbtools.dbeaver.psqldebug.rulerToggleBreakpoint"
                icon="platform:/plugin/org.eclipse.debug.ui/icons/full/obj16/brkp_obj.svg"/>
        <image
                commandId="dev.fbtools.dbeaver.psqldebug.openPackage"
                icon="platform:/plugin/org.jkiss.dbeaver.model/icons/tree/package.svg"/>
    </extension>

    <extension point="org.eclipse.core.expressions.propertyTesters">
        <propertyTester
                id="dev.fbtools.dbeaver.psqldebug.routineEditorTester"
                type="java.lang.Object"
                namespace="dev.fbtools.dbeaver.psqldebug"
                properties="breakpointSource"
                class="dev.fbtools.dbeaver.psqldebug.editor.RoutineEditorTester"/>
    </extension>

    <extension point="org.eclipse.ui.handlers">
        <!-- Vale sempre a Rotina do editor ativo, também com o navegador ou uma view do debug em foco: o editor de objeto
             de uma procedure, function ou trigger de tabela Firebird, ou o editor SQL de conexão Firebird (EXECUTE
             BLOCK, console de package). A seleção do navegador não conta: o launch sai do editor, onde ficam os
             breakpoints (issue 21). O teste é sobre o editor, e não sobre activeEditorInput (RoutineEditorTester). -->
        <handler
                commandId="dev.fbtools.dbeaver.psqldebug.debugRoutine"
                class="dev.fbtools.dbeaver.psqldebug.launch.DebugRoutineHandler">
            <enabledWhen>
                <with variable="activeEditor">
                    <test property="dev.fbtools.dbeaver.psqldebug.breakpointSource" forcePluginActivation="true"/>
                </with>
            </enabledWhen>
        </handler>
        <!-- O handler confere se há conexão Firebird no contexto (navegador ou editor ativo). -->
        <handler
                commandId="dev.fbtools.dbeaver.psqldebug.openPackage"
                class="dev.fbtools.dbeaver.psqldebug.launch.OpenPackageHandler"/>
        <!-- Ctrl+Shift+B: o debug.ui só liga o comando a um handler pelo breakpointActionSet, que o DBeaver não
             exibe. Ativo só no editor de objeto de Rotina Firebird e no editor SQL de conexão Firebird, para não tomar
             o comando de outros debuggers. O teste é sobre o editor, e não sobre activeEditorInput, que fica com a
             entrada provisória de um editor restaurado (RoutineEditorTester). -->
        <handler
                commandId="org.eclipse.debug.ui.commands.ToggleBreakpoint"
                class="dev.fbtools.dbeaver.psqldebug.editor.ToggleBreakpointHandler">
            <activeWhen>
                <and>
                    <with variable="activePartId">
                        <or>
                            <equals value="org.jkiss.dbeaver.ui.editors.entity.EntityEditor"/>
                            <equals value="org.jkiss.dbeaver.ui.editors.sql.SQLEditor"/>
                        </or>
                    </with>
                    <with variable="activeEditor">
                        <test property="dev.fbtools.dbeaver.psqldebug.breakpointSource" forcePluginActivation="true"/>
                    </with>
                </and>
            </activeWhen>
        </handler>
        <handler
                commandId="dev.fbtools.dbeaver.psqldebug.rulerToggleBreakpoint"
                class="dev.fbtools.dbeaver.psqldebug.editor.RulerToggleBreakpointHandler">
            <enabledWhen>
                <with variable="activeEditor">
                    <test property="dev.fbtools.dbeaver.psqldebug.breakpointSource" forcePluginActivation="true"/>
                </with>
            </enabledWhen>
        </handler>
    </extension>

    <extension point="org.eclipse.ui.menus">
        <menuContribution locationURI="menu:org.eclipse.ui.main.menu?after=additions">
            <menu id="dev.fbtools.dbeaver.psqldebug.menu" label="PSQL Debug">
                <command commandId="dev.fbtools.dbeaver.psqldebug.debugRoutine"/>
                <command commandId="dev.fbtools.dbeaver.psqldebug.openPackage"/>
            </menu>
        </menuContribution>
        <!-- Menu de contexto do texto dos editores SQL do DBeaver (a pasta Source do editor de objeto e o editor SQL).
             Só no editor de uma Rotina Firebird e no editor SQL de conexão Firebird. O navegador não tem o item: sem o
             editor aberto não há onde pôr breakpoints antes do launch (issue 21). -->
        <menuContribution allPopups="false" locationURI="popup:#SQLEditorContext?after=additions">
            <command commandId="dev.fbtools.dbeaver.psqldebug.debugRoutine">
                <visibleWhen>
                    <with variable="activeEditor">
                        <test property="dev.fbtools.dbeaver.psqldebug.breakpointSource" forcePluginActivation="true"/>
                    </with>
                </visibleWhen>
            </command>
        </menuContribution>
        <!-- Menu de contexto do ruler dos editores SQL do DBeaver. -->
        <menuContribution allPopups="false" locationURI="popup:#SQLRulerContext?before=additions">
            <command commandId="dev.fbtools.dbeaver.psqldebug.rulerToggleBreakpoint">
                <visibleWhen checkEnabled="true"/>
            </command>
        </menuContribution>
    </extension>

    <!-- ===== Breakpoints de linha (issue 14) ===== -->

    <!-- Não persistente: o breakpoint existe só enquanto o editor da Rotina está aberto (ADR 0004). -->
    <extension point="org.eclipse.core.resources.markers"
               id="lineBreakpointMarker"
               name="Firebird PSQL breakpoint">
        <super type="org.eclipse.debug.core.lineBreakpointMarker"/>
        <persistent value="false"/>
    </extension>

    <extension point="org.eclipse.debug.core.breakpoints">
        <breakpoint
                id="dev.fbtools.dbeaver.psqldebug.lineBreakpoint"
                markerType="dev.fbtools.dbeaver.psqldebug.lineBreakpointMarker"
                class="dev.fbtools.dbeaver.psqldebug.debug.PsqlLineBreakpoint"
                name="Firebird PSQL breakpoint"/>
    </extension>

    <!-- ===== Step into e step return (issue 17) ===== -->

    <!-- F7 (step return) no editor SQL (console de package, EXECUTE BLOCK): o SQLEditor do DBeaver ativa sempre o
         contexto org.jkiss.dbeaver.ui.context.resultset, que liga F7 ao "toggle preview" da grade. Ele e o
         org.eclipse.debug.ui.debugging têm a mesma profundidade, e o E4 desempata pelo id, o que dá F7 ao DBeaver. Um
         contexto filho do debugging, ativo enquanto a Sessão de debug está selecionada na view Debug, ganha pela
         profundidade. F5, F6 e F8 não têm esse conflito. -->
    <extension point="org.eclipse.ui.contexts">
        <context
                id="dev.fbtools.dbeaver.psqldebug.debugging"
                name="Depurando Firebird PSQL"
                parentId="org.eclipse.debug.ui.debugging"/>
    </extension>

    <extension point="org.eclipse.debug.ui.debugModelContextBindings">
        <modelContextBinding
                debugModelId="dev.fbtools.dbeaver.psqldebug.psql"
                contextId="dev.fbtools.dbeaver.psqldebug.debugging"/>
    </extension>

    <extension point="org.eclipse.ui.bindings">
        <key
                sequence="F7"
                contextId="dev.fbtools.dbeaver.psqldebug.debugging"
                commandId="org.eclipse.debug.ui.commands.StepReturn"
                schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"/>
    </extension>

    <!-- Aviso "executado no servidor" no nome de cada chamada sem step into do texto da Rotina, durante a Sessão de
         debug (ServerCallAnnotations). Sem marker: a anotação é posta e tirada à mão, como a marca do breakpoint. -->
    <extension point="org.eclipse.ui.editors.annotationTypes">
        <type name="dev.fbtools.dbeaver.psqldebug.serverCall"/>
    </extension>

    <extension point="org.eclipse.ui.editors.markerAnnotationSpecification">
        <specification
                annotationType="dev.fbtools.dbeaver.psqldebug.serverCall"
                label="Executado no servidor (Firebird PSQL Debugger)"
                symbolicIcon="info"
                presentationLayer="4"
                colorPreferenceKey="dev.fbtools.dbeaver.psqldebug.serverCall.color"
                colorPreferenceValue="130,160,190"
                textPreferenceKey="dev.fbtools.dbeaver.psqldebug.serverCall.text"
                textPreferenceValue="true"
                textStylePreferenceKey="dev.fbtools.dbeaver.psqldebug.serverCall.textStyle"
                textStylePreferenceValue="DASHED_BOX"
                highlightPreferenceKey="dev.fbtools.dbeaver.psqldebug.serverCall.highlight"
                highlightPreferenceValue="false"
                overviewRulerPreferenceKey="dev.fbtools.dbeaver.psqldebug.serverCall.overviewRuler"
                overviewRulerPreferenceValue="true"
                verticalRulerPreferenceKey="dev.fbtools.dbeaver.psqldebug.serverCall.verticalRuler"
                verticalRulerPreferenceValue="true"
                contributesToHeader="false"
                includeOnPreferencePage="true"/>
    </extension>

    <!-- Duplo-clique no ruler: o editor de texto da pasta Source do editor de procedure (site "generic.source.view")
         procura a ação RulerDoubleClick nas contribuições com o id do site dele, na hora do clique. A ação roda o
         comando de definitionId; a classe só valeria para um editor de primeiro nível com esse id, que não existe. -->
    <extension point="org.eclipse.ui.editorActions">
        <editorContribution
                id="dev.fbtools.dbeaver.psqldebug.sourceRulerActions"
                targetID="generic.source.view">
            <action
                    id="dev.fbtools.dbeaver.psqldebug.rulerDoubleClick"
                    label="Alternar Breakpoint"
                    actionID="RulerDoubleClick"
                    definitionId="dev.fbtools.dbeaver.psqldebug.rulerToggleBreakpoint"
                    class="org.eclipse.debug.ui.actions.RulerToggleBreakpointActionDelegate"/>
        </editorContribution>
        <!-- O editor SQL do DBeaver é de primeiro nível: o workbench pode instanciar a classe da ação, que alterna o
             breakpoint só num editor de conexão Firebird (EXECUTE BLOCK, console de package). -->
        <editorContribution
                id="dev.fbtools.dbeaver.psqldebug.sqlRulerActions"
                targetID="org.jkiss.dbeaver.ui.editors.sql.SQLEditor">
            <action
                    id="dev.fbtools.dbeaver.psqldebug.sqlRulerDoubleClick"
                    label="Alternar Breakpoint"
                    actionID="RulerDoubleClick"
                    definitionId="dev.fbtools.dbeaver.psqldebug.rulerToggleBreakpoint"
                    class="dev.fbtools.dbeaver.psqldebug.editor.RulerToggleBreakpointAction"/>
        </editorContribution>
    </extension>

</plugin>
